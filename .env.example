# Browser-safe Supabase Project URL and publishable key (not the secret key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Supabase secret key or legacy service_role key; never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Canonical origin. No trailing slash. Use a separate project/config for preview deployments.
SITE_URL=http://localhost:3001
# Keep false for invited accounts. Enable only with Supabase CAPTCHA and email delivery configured.
NEXT_PUBLIC_ALLOW_SIGNUP=false
# Cloudflare Turnstile. Register the canonical hostname and configure the same provider in Supabase Auth.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Long random server secret used by Vercel Cron. Generate with openssl rand -hex 32.
CRON_SECRET=
